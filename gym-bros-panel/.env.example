# Copiar este archivo a `.env` para desarrollo local:
#   cp .env.example .env
# `.env` está ignorado por Git. Nunca añadir aquí claves ni tokens reales:
# todo lo que empieza por VITE_ acaba dentro del bundle público del navegador.

# Nombre visible de la aplicación (título del documento, layout de acceso, sidebar).
VITE_APP_NAME=Gym Bros

# URL base de la API REST de Laravel 11.
# - Desarrollo: `/api`; Vite la reenvía a VITE_API_PROXY_TARGET (sin IPs fijas).
# - Producción: la URL HTTPS pública de la API, p. ej. https://api.ejemplo.com/api
VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo (`php artisan serve` o scripts/serve-dev.ps1).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# true  -> la capa de servicios responde con datos simulados de los módulos
# false -> la capa de servicios habla con la API real de Laravel
VITE_USE_MOCKS=false
