# Plantilla de variables para PRODUCCION. Copiar a `.env` en el servidor y
# completar los valores marcados con <...>. Nunca subir el `.env` real al repo.

APP_NAME="Gym Bros"
APP_ENV=production
# Nunca true en produccion: expone trazas, rutas y variables.
APP_DEBUG=false
APP_KEY=<php artisan key:generate --show>
APP_TIMEZONE=UTC
APP_URL=https://<dominio-de-la-api>
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<host>
DB_PORT=3306
DB_DATABASE=<base>
DB_USERNAME=<usuario-con-permisos-minimos>
DB_PASSWORD=<clave>

SESSION_DRIVER=database
SESSION_ENCRYPT=true
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Origenes del panel web separados por comas (sin barra final).
CORS_ALLOWED_ORIGINS=https://<dominio-del-panel>
FRONTEND_URL=https://<dominio-del-panel>

# IPs del proxy/balanceador que termina TLS, o * si solo el proxy llega a PHP.
# Sin esto la API responde 400 "Se requiere HTTPS" detras de un proxy.
TRUSTED_PROXIES=<ip-del-proxy|*>

MAIL_MAILER=smtp
MAIL_HOST=<smtp>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<clave>
MAIL_FROM_ADDRESS=<no-responder@dominio>
MAIL_FROM_NAME="${APP_NAME}"

# Pagos con Mercado Pago: pendiente de implementar. Mientras sea false, el
# checkout responde 503 y ningun flujo de pago se activa.
MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
MP_LIVE_MODE=false
ONBOARDING_LOGO=email/notificaciones-fondo.webp
